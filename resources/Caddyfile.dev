# `tinvar serve --dev`: FrankenPHP in front of Vite's dev server.
#
# Every app is served this one way in dev, so this is the framework's, not
# the app's: the app's own Caddyfile is how it is served from a build, and
# dev has no build. Started by ServeCommand with the variables read here:
# where to listen (TINVAR_HOST, TINVAR_PORT -- loopback only), the app
# (TINVAR_APP_ROOT), the dev server's port (TINVAR_VITE_PORT), and the live
# hub's keys and audience (TINVAR_LIVE_*), which the app hands ServeCommand
# as it does for its own Caddyfile -- with the origin of a hub of its own
# when TINVAR_LIVE_HUB_URL names one.
{
	admin off
	persist_config off
	auto_https off

	# No worker: every request runs the front controller afresh, so an edit
	# to the PHP is in the very next response, as an edit to a component is.
	#
	# PHP takes uploads up to the framework's own ceiling
	# (Uploads::DEFAULT_MAX_BYTES), so in dev an upload is refused by the
	# app's declared limit and not by PHP's 2M default first.
	frankenphp {
		php_ini upload_max_filesize 10M
		php_ini post_max_size 11M
	}

	# The Host check below goes ahead of everything, the hub and the dev
	# server's modules included.
	order respond first
}

http://:{$TINVAR_PORT} {
	bind {$TINVAR_HOST}

	# Only a request naming this machine. Dev listens on loopback, and a page
	# that points a name of its own at 127.0.0.1 -- DNS rebinding -- reaches
	# it same-origin from its visitor's machine, to read the pages, the raw
	# errors dev shows, and the source the dev server serves. What it cannot
	# change is the Host its requests name: an address, localhost, or a name
	# under .localhost, which a browser resolves to loopback itself.
	@foreignhost not host localhost 127.0.0.1 ::1 [::1] *.localhost *.*.localhost
	respond @foreignhost "Misdirected Request" 421

	# The live hub, as an app's own Caddyfile runs it (Tinvar\Live, ADR
	# 0030): FrankenPHP's built-in Mercure, which the front controller
	# publishes to in-process, letting in only a subscriber with an access
	# token PHP signed, read from its cookie. Live updates work in dev as
	# they do from a build -- through a hub of its own, too, when one is
	# named, with this one out of the way (ADR 0048).
	@builtinhub expression "'{$TINVAR_LIVE_HUB_UPSTREAM}' == ''"
	mercure @builtinhub {
		transport local
		issuer tinvar {
			publisher {
				jwt {env.TINVAR_LIVE_PUBLISHER_KEY} HS256
			}
			subscriber {
				jwt {env.TINVAR_LIVE_SUBSCRIBER_KEY} HS256
			}
		}
		resource_identifier {$TINVAR_LIVE_AUDIENCE:https://live.tinvar.invalid/.well-known/mercure}
		cookie_name __Secure-tinvar-live
	}

	@remotehub {
		path /.well-known/mercure /.well-known/mercure/*
		expression "'{$TINVAR_LIVE_HUB_UPSTREAM}' != ''"
	}
	handle @remotehub {
		reverse_proxy {$TINVAR_LIVE_HUB_UPSTREAM} {
			# Its own cookie and nothing else: the session's and the CSRF
			# token's are this server's, and a service apart has no use for
			# either. No Authorization, which the hub would read before the
			# cookie.
			header_up -Authorization
			header_up Cookie "__Secure-tinvar-live={http.request.cookie.__Secure-tinvar-live}"
		}
	}

	# The dev server's modules and its HMR socket, on this same origin. Vite
	# serves everything under this base, so nothing of the app can collide
	# with it: /_ is the framework's prefix. The upstream is loopback, and
	# this file is read only by `serve --dev`, which production never runs.
	handle /_vite/* {
		reverse_proxy 127.0.0.1:{$TINVAR_VITE_PORT}
	}

	# The app. None of the headers below is for the client: Tinvar\Http\Sapi
	# marks a large or unmeasured response with X-Accel-Buffering, for an
	# app's own Caddyfile to read, and here nothing reads it. No `intercept`
	# around `php` as an app's Caddyfile has (ADR 0081): dev runs no workers,
	# serves one person on loopback, and hands no stored file to a file
	# server -- PHP is told no TINVAR_FILE_ROOT, so it sends files itself.
	handle {
		root * {$TINVAR_APP_ROOT}/public
		rewrite * /index.php
		header {
			-X-Powered-By
			-X-Accel-Buffering
			-X-Accel-Redirect
		}
		php
	}
}
