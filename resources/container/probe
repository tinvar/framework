#!/bin/sh
# A probe of PHP's container in the two-container shape (ADR 0071): PATH,
# /_health or /_ready, asked over loopback as this container's own user,
# which is never root there. ProbeAccess lets a loopback peer in without the
# token (ADR 0041), so none is passed, and nothing of the container's
# environment either. The image's HEALTHCHECK, and a pod's exec probes:
# kubelet's own HTTP probes come from the node, not loopback, and would need
# the token in the manifest.
#
# Only 200 passes.
# shellcheck disable=SC2016 # PHP's variables, in PHP's code
case ${1:-} in
    /_health | /_ready) ;;
    *)
        echo "usage: probe /_health | /_ready" >&2
        exit 64
        ;;
esac
exec env -i PATH=/usr/local/bin:/usr/bin:/bin /usr/local/bin/php -n -r '
    $context = stream_context_create(["http" => ["timeout" => 4, "ignore_errors" => true]]);
    $body = @file_get_contents($argv[1], false, $context);
    $status = http_get_last_response_headers()[0] ?? "no answer";
    if (preg_match("#^HTTP/\S+ 200 #", $status) !== 1) {
        fwrite(STDERR, "{$argv[2]}: {$status} " . substr((string) $body, 0, 300) . "\n");
        exit(1);
    }
    echo "ok\n";
' "http://127.0.0.1:${TINVAR_CONTAINER_PORT:-8080}$1" "$1"
