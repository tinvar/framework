#!/bin/bash
# The container's first process, and the only one that is root (ADR 0068).
# It checks what it is given, starts the application's PHP side and its
# renderers, each as a user of its own, and then stops being root: it becomes
# tini, as PHP's user, running the supervisor. From then on nothing in the
# container is root or holds a capability.
#
#   entrypoint                 serve: the renderers, then the PHP side
#   entrypoint tinvar ARGS...  bin/tinvar ARGS as the app's user, and exit
#   entrypoint CMD ARGS...     CMD as the app's user, and exit
#
# It runs as root with no capability but CAP_SETUID and CAP_SETGID, to start
# each process as its user, and CAP_SETPCAP, to empty the bounding set of
# everything it starts. It runs no application code itself, and nothing it
# starts keeps a capability or can gain one (no_new_privs).
#
#   - The renderers run as TINVAR_RENDERER_USER, in the socket group, with
#     an environment of PATH, NODE_ENV, TZ, LANG and LC_ALL and nothing
#     else: no secret this container was given reaches them. They are
#     started through `renderers`, which takes the supervisor's commands on
#     a pipe -- restart, stop -- and signals the pool as its own user.
#   - The PHP side runs as TINVAR_CONTAINER_APP_USER, in its own group and
#     the socket group, with the container's environment. TINVAR_RENDERER_USER
#     and TINVAR_SOCKET tell it which pool to render through and whose
#     processes must answer there.
#   - tini and `supervise` run as PHP's user, in no other group, with an
#     environment of PATH alone. The supervisor signals PHP's processes as
#     their own user and the renderers through that pipe: it needs nothing
#     of root's, and holds no identity but one the container already runs.
#
# Before either starts it checks what would otherwise fail late or quietly,
# and refuses to start: the users and their group, the capabilities, an app
# key given, the pool's directory a tmpfs of the renderers' user, and that
# the renderers' user can read none of the paths TINVAR_CONTAINER_PRIVATE
# names, nor the key file.
set -euo pipefail

app_user=${TINVAR_CONTAINER_APP_USER:-tinvar-app}
renderer_user=${TINVAR_RENDERER_USER:-}
socket_group=${TINVAR_CONTAINER_SOCKET_GROUP:-tinvar-render}
pool=${TINVAR_SOCKET:-}
port=${TINVAR_CONTAINER_PORT:-8080}

say() { echo "[tinvar:container] $(date -u +%H:%M:%S.%3N) $*" >&2; }
refuse() {
    say "$*"
    exit 78 # EX_CONFIG
}

# The production profile, whatever is asked of the container: the browser
# test endpoint is never served from an image (ADR 0066). First, so nothing
# starts under it -- not a one-off command either.
if [ -n "${TINVAR_PROFILE:-}" ] && [ "$(printf %s "$TINVAR_PROFILE" | tr '[:upper:]' '[:lower:]')" != production ]; then
    refuse "TINVAR_PROFILE=$TINVAR_PROFILE: an image serves the production profile. The test profile is a browser test run's, on its own machine."
fi
for variable in TINVAR_TEST_RUN TINVAR_BUILD_DIR; do
    if [ -n "${!variable:-}" ]; then
        refuse "$variable is set: an image serves its own build to no browser test run. Unset it."
    fi
done

# Each as its user. The bounding set emptied while CAP_SETPCAP is held, then
# the ids, which empty the permitted and effective sets as the last root id
# goes; no inheritable or ambient capability, and no_new_privs: what runs
# under these keeps nothing of root's and can gain nothing back. Commands,
# not functions, so a process started with one is that process, and the pid
# signalled is the one that runs.
drop=(--bounding-set=-all --inh-caps=-all --ambient-caps=-all --no-new-privs)
as_app=(setpriv --reuid="$app_user" --regid="$app_user" --init-groups "${drop[@]}" --)
as_renderer=(setpriv --reuid="$renderer_user" --regid="$socket_group" --clear-groups "${drop[@]}" --)
as_supervisor=(setpriv --reuid="$app_user" --regid="$app_user" --clear-groups "${drop[@]}" --)

[ "$(id -u)" = 0 ] || refuse "Started as uid $(id -u). This entrypoint starts the renderers and PHP as two users, and only root can: run the image as root with --cap-drop ALL --cap-add SETUID --cap-add SETGID --cap-add SETPCAP (examples/shop/compose.yaml). It stops being root once both are started."

# CAP_SETGID (6), CAP_SETUID (7) and CAP_SETPCAP (8), in the effective set.
capabilities=$(awk '/^CapEff:/ { print $2 }' /proc/self/status)
for bit in 6 7 8; do
    if (((16#$capabilities >> bit & 1) == 0)); then
        refuse "Missing a capability: this entrypoint needs CAP_SETUID and CAP_SETGID to start each process as its user, and CAP_SETPCAP to drop every capability from what it starts (CapEff is $capabilities)."
    fi
done

[ -n "$renderer_user" ] || refuse "TINVAR_RENDERER_USER is not set: the renderers run as a user of their own here."
app_uid=$(id -u "$app_user") || refuse "No user $app_user for PHP."
renderer_uid=$(id -u "$renderer_user") || refuse "No user $renderer_user for the renderers."
socket_gid=$(getent group "$socket_group" | cut -d: -f3) || refuse "No group $socket_group for the renderers' sockets."
if [ "$app_uid" = 0 ] || [ "$renderer_uid" = 0 ] || [ "$app_uid" = "$renderer_uid" ]; then
    refuse "PHP ($app_user, $app_uid) and the renderers ($renderer_user, $renderer_uid) must be two users, neither root."
fi

# One-off commands, as the app's user, under tini: a migration, a seed, a
# check.
if [ $# -gt 0 ]; then
    cd "${TINVAR_CONTAINER_CWD:-/}"
    if [ "$1" = tinvar ]; then
        shift
        exec "${as_app[@]}" /usr/local/bin/tini -- php "${TINVAR_CONTAINER_TINVAR:?names bin/tinvar}" "$@"
    fi
    exec "${as_app[@]}" /usr/local/bin/tini -- "$@"
fi

[ -n "$pool" ] || refuse "TINVAR_SOCKET is not set: it names the renderers' pool directory."
# The group of two, as ADR 0028 has it: the renderers' user, whose primary
# group it is, and PHP's, listed.
members=$(getent group "$socket_group" | cut -d: -f4)
if [ "$members" != "$app_user" ]; then
    refuse "The group $socket_group must list $app_user and no one else (it is $renderer_user's primary group); it lists '$members'."
fi

# No key baked in, and none generated where a restart would lose it.
if [ -z "${TINVAR_APP_KEY:-}" ] && [ -z "${TINVAR_APP_KEY_FILE:-}" ]; then
    refuse "No app key: set TINVAR_APP_KEY, or TINVAR_APP_KEY_FILE to a mounted secret PHP's user can read. The image holds none."
fi

# What PHP keeps from the renderers: each path, and the key file. Checked
# as the renderers' user, so whatever the mounts and their modes, it is
# what the kernel would let a renderer do.
IFS=: read -r -a private <<<"${TINVAR_CONTAINER_PRIVATE:-}"
[ -z "${TINVAR_APP_KEY_FILE:-}" ] || private+=("$TINVAR_APP_KEY_FILE")
for path in "${private[@]}"; do
    [ -n "$path" ] || continue
    # Read, or for a directory passed through: a file in one it may enter
    # is opened by name.
    if "${as_renderer[@]}" test -r "$path" || { [ -d "$path" ] && "${as_renderer[@]}" test -x "$path"; }; then
        refuse "$renderer_user can read $path, which is PHP's alone: make it $app_user's, mode 0700 for a directory, 0600 or 0400 for a file."
    fi
done
if [ -n "${TINVAR_APP_KEY_FILE:-}" ] && ! "${as_app[@]}" test -r "$TINVAR_APP_KEY_FILE"; then
    refuse "$app_user cannot read TINVAR_APP_KEY_FILE ($TINVAR_APP_KEY_FILE)."
fi

# The pool's directory: the renderers' user's own, writable by no one else,
# and a tmpfs, so nothing of an earlier run -- a pid file naming a pid this
# run has given to something else -- is still there.
if ! awk -v at="$pool" '$5 == at { for (i = 7; $i != "-"; i++); if ($(i + 1) == "tmpfs") found = 1 } END { exit !found }' /proc/self/mountinfo; then
    refuse "$pool is not a tmpfs. Mount one there, the renderers' user's: --tmpfs $pool:uid=$renderer_uid,gid=$socket_gid,mode=0750"
fi
read -r owner mode < <(stat -c '%u %a' "$pool")
if [ "$owner" != "$renderer_uid" ] || (((8#$mode & 8#022) != 0)); then
    refuse "$pool is uid $owner, mode $mode: it must be $renderer_user's ($renderer_uid), writable by no one else."
fi
"${as_app[@]}" test -w /tmp || refuse "/tmp is not writable by $app_user: mount a tmpfs there (--tmpfs /tmp)."

cpus=$(nproc)
workers=${TINVAR_CONTAINER_WORKERS:-$cpus}
renderers=${TINVAR_CONTAINER_RENDERERS:-$((cpus / 2 > workers ? workers : cpus / 2))}
((renderers >= 1)) || renderers=1

say "Starting $renderers renderers as $renderer_user in $pool, then PHP with $workers workers as $app_user on port $port."

# The renderers: Node itself, as the systemd unit in docs/deployment.md
# runs it, so their user reads no PHP, under `renderers`, whose standard
# input is a pipe whose other end only the supervisor holds. Started as
# their user, so `renderers` signals the pool as its own.
renderer_env=(PATH=/usr/local/bin:/usr/bin:/bin NODE_ENV=production)
for name in TZ LANG LC_ALL; do
    [ -z "${!name:-}" ] || renderer_env+=("$name=${!name}")
done
exec {control}> >(exec env -i "${renderer_env[@]}" \
    "${as_renderer[@]}" /usr/local/lib/tinvar/renderers node "${TINVAR_CONTAINER_RENDERER:?names renderer.js}" "$pool" \
    "${TINVAR_CONTAINER_RENDER_ENTRY:?names the app rsc entry}" \
    --processes="$renderers" --socket-group="$socket_group")
renderer_pid=$!

# The PHP side, with the pipe's end closed: PHP can neither restart the
# renderers nor keep them from stopping. `tinvar serve` waits for the pool
# and holds it to the renderers' user before FrankenPHP starts.
cd "${TINVAR_CONTAINER_CWD:-/}"
# shellcheck disable=SC2086 # the command and its arguments, split as written
"${as_app[@]}" ${TINVAR_CONTAINER_SERVE:?names the command that serves} \
    --host=0.0.0.0 --port="$port" --workers="$workers" {control}>&- &
php_pid=$!

# Root no more. Both sides are this process's children, and stay tini's
# when it takes this pid: tini reaps them, and every orphan, as PID 1. The
# supervisor gets the pipe to the renderers, the two pids, and no secret.
cd /
exec env -i PATH=/usr/local/bin:/usr/bin:/bin \
    "${as_supervisor[@]}" /usr/local/bin/tini -- /usr/local/lib/tinvar/supervise \
    "$control" "$renderer_pid" "$php_pid" "$app_uid" "$renderer_uid"
