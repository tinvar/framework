#!/usr/bin/env bash
#
# Whether a _FILE variable may name a compose secret the entrypoint reads as
# root (ADR 0059), and the variable it sets:
#
#   secret-file /run/secrets TINVAR_APP_KEY_FILE /run/secrets/app_key
#     -> prints TINVAR_APP_KEY, or says why not and exits 78
#
# The entrypoint and the healthcheck pass /run/secrets; a test passes a
# directory of its own. Held to, before anything is read:
#
#   - the variable is TINVAR_<NAME>_FILE, or APP_DATABASE_PASSWORD_FILE, the
#     one app variable a secret is given by: never LD_PRELOAD_FILE or
#     PATH_FILE, which would set what the next process loads or runs;
#   - the path is the directory and one name in it -- no `..`, no `.`, no
#     empty component, no further directory -- so its parent is exactly the
#     directory;
#   - neither the directory, nor any directory above it, nor the file is a
#     symlink, and the path resolves (realpath, every component there) to
#     itself;
#   - the file is a regular file.
#
# Who may read it -- not the renderers' user -- is the caller's to check.

set -euo pipefail

refuse() {
    echo "$*" >&2
    exit 78 # EX_CONFIG
}

[ $# -eq 3 ] || refuse "usage: secret-file <directory> <variable> <path>"
dir=$1
variable=$2
file=$3

if [[ $variable =~ ^TINVAR_[A-Z0-9_]*[A-Z0-9]_FILE$ ]] || [ "$variable" = APP_DATABASE_PASSWORD_FILE ]; then
    name=${variable%_FILE}
else
    refuse "$variable names a secret in $dir, and only a TINVAR_*_FILE variable, or APP_DATABASE_PASSWORD_FILE, may: the entrypoint sets no other variable from a file."
fi

base=${file#"$dir"/}
if [ "$base" = "$file" ] || [[ ! $base =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]] || [[ $base == *..* ]]; then
    refuse "$variable names $file: a secret is one name directly in $dir -- letters, digits, '.', '_' or '-', no '..' and no other directory."
fi

# No symlink on the way: the directory and every one above it, then the file.
at=$dir
while [ -n "$at" ] && [ "$at" != / ]; do
    [ ! -L "$at" ] || refuse "$at is a symlink, on the way to $variable's $file."
    at=${at%/*}
done
[ -d "$dir" ] || refuse "$dir is not a directory, and $variable names $file in it."
[ ! -L "$file" ] || refuse "$variable names $file, which is a symlink."
[ -f "$file" ] || refuse "$variable names $file, which is not a file: is the secret listed under the service's secrets:?"

# Every component there, and the path its own canonical form. GNU realpath
# takes -e; BSD's, where a test runs, refuses a missing path by default.
if realpath -e / >/dev/null 2>&1; then
    real=$(realpath -e -- "$file") || refuse "$variable's $file does not resolve."
else
    real=$(realpath -- "$file") || refuse "$variable's $file does not resolve."
fi
[ "$real" = "$file" ] || refuse "$variable names $file, which resolves to $real: give the path itself."

echo "$name"
