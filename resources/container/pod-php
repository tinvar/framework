#!/bin/bash
# PHP's container in the two-container shape (ADR 0071): the image starts as
# PHP's own user, and this checks what it was given and becomes serve. The
# renderers are another container, of their own image and user, sharing a
# socket volume with this one and nothing else: nothing here starts one,
# changes user or holds a capability.
#
#   pod-php                 serve: FrankenPHP, the queue worker, the scheduler
#   pod-php tinvar ARGS...  bin/tinvar ARGS, and exit
#   pod-php CMD ARGS...     CMD, and exit
#
# It refuses to start, with exit 78, unless:
#
#   - it is TINVAR_CONTAINER_APP_USER, not root, with every capability set
#     empty, bounding set included, and no_new_privs: compose's cap_drop ALL
#     and no-new-privileges, a pod's drop ALL and allowPrivilegeEscalation
#     false. A platform that leaves either out is one this does not run on.
#   - the renderers' user is named, and is neither root nor this user;
#   - for serve: it is in the socket group the renderers share their sockets
#     with, an app key is given, TINVAR_SOCKET names their pool, loopback
#     is held to the probe token (TINVAR_PROBE_TRUST_LOOPBACK=0), a
#     probe token of 32 characters or more is given, and the stop budget
#     (TINVAR_STOP_BUDGET) fits the platform's grace (TINVAR_STOP_GRACE).
#
# The stop is serve's own (ADR 0063): SIGTERM, passed on by tini, stops the
# queue worker, which finishes the job in hand or, within the stop budget,
# pauses or hands it back (ADR 0078), and the scheduler, then
# FrankenPHP, which finishes its requests. The renderers' container is
# stopped after this one by the platform: compose's depends_on, a pod's
# sidecar order.
set -euo pipefail

app_user=${TINVAR_CONTAINER_APP_USER:-tinvar-app}
renderer_user=${TINVAR_RENDERER_USER:-}
socket_group=${TINVAR_CONTAINER_SOCKET_GROUP:-tinvar-render}
pool=${TINVAR_SOCKET:-}
port=${TINVAR_CONTAINER_PORT:-8080}

say() { echo "[tinvar:container] $(date -u +%H:%M:%S.%3N) $*" >&2; }
refuse() {
    say "$*"
    exit 78 # EX_CONFIG
}

# The production profile, whatever is asked (ADR 0066), as the one
# container's entrypoint has it.
if [ -n "${TINVAR_PROFILE:-}" ] && [ "$(printf %s "$TINVAR_PROFILE" | tr '[:upper:]' '[:lower:]')" != production ]; then
    refuse "TINVAR_PROFILE=$TINVAR_PROFILE: an image serves the production profile. The test profile is a browser test run's, on its own machine."
fi
for variable in TINVAR_TEST_RUN TINVAR_BUILD_DIR; do
    if [ -n "${!variable:-}" ]; then
        refuse "$variable is set: an image serves its own build to no browser test run. Unset it."
    fi
done

uid=$(id -u)
[ "$uid" != 0 ] || refuse "Started as root. This image starts as $app_user and needs nothing of root's: run it as its USER, with every capability dropped."
app_uid=$(id -u "$app_user") || refuse "No user $app_user for PHP."
[ "$uid" = "$app_uid" ] || refuse "Started as uid $uid, not $app_user ($app_uid): the renderers are held to another uid, and the image's files to this one."

# Every capability set empty -- the bounding set too, so nothing run from
# here could gain one from a file -- and no_new_privs.
while read -r field value; do
    case $field in
        CapInh: | CapPrm: | CapEff: | CapBnd: | CapAmb:)
            [ "$value" = 0000000000000000 ] \
                || refuse "${field%:} is $value: drop every capability (compose: cap_drop: [ALL]; a pod: capabilities.drop: [ALL])."
            ;;
        NoNewPrivs:)
            [ "$value" = 1 ] \
                || refuse "no_new_privs is not set: run with no-new-privileges (compose: security_opt; a pod: allowPrivilegeEscalation: false)."
            ;;
    esac
done </proc/self/status

[ -n "$renderer_user" ] || refuse "TINVAR_RENDERER_USER is not set: the renderers run as a user of their own, in their own container."
renderer_uid=$(id -u "$renderer_user") || refuse "No user $renderer_user for the renderers."
if [ "$renderer_uid" = 0 ] || [ "$renderer_uid" = "$app_uid" ]; then
    refuse "The renderers ($renderer_user, $renderer_uid) must be a user of their own, neither root nor $app_user."
fi

# One-off commands: a migration, a seed, a check.
if [ $# -gt 0 ]; then
    cd "${TINVAR_CONTAINER_CWD:-/}"
    if [ "$1" = tinvar ]; then
        shift
        exec php "${TINVAR_CONTAINER_TINVAR:?names bin/tinvar}" "$@"
    fi
    exec "$@"
fi

[ -n "$pool" ] || refuse "TINVAR_SOCKET is not set: it names the renderers' pool directory, in the volume shared with their container."
socket_gid=$(getent group "$socket_group" | cut -d: -f3) || refuse "No group $socket_group for the renderers' sockets."
# The group the platform adds -- compose's group_add, a pod's
# supplementalGroups -- without which no socket of theirs can be connected to.
case " $(id -G) " in
    *" $socket_gid "*) ;;
    *) refuse "Not in $socket_group ($socket_gid), which the renderers share their sockets with: add it (compose: group_add; a pod: supplementalGroups). In: $(id -G)." ;;
esac

if [ -z "${TINVAR_APP_KEY:-}" ] && [ -z "${TINVAR_APP_KEY_FILE:-}" ]; then
    refuse "No app key: set TINVAR_APP_KEY, or TINVAR_APP_KEY_FILE to a mounted secret this user can read. The image holds none."
fi
if [ -n "${TINVAR_APP_KEY_FILE:-}" ] && ! [ -r "$TINVAR_APP_KEY_FILE" ]; then
    refuse "$app_user cannot read TINVAR_APP_KEY_FILE ($TINVAR_APP_KEY_FILE)."
fi
# Loopback is the pod's, not this container's alone -- the renderers'
# sidecar, a mesh's proxy, `kubectl port-forward` -- so ProbeAccess holds it
# to the token (TINVAR_PROBE_TRUST_LOOPBACK=0, as the image has it): exactly
# 0, since the shop reads an empty value as 1. And a token PHP takes, 32
# characters or more, or no probe -- this image's own included -- passes.
# Its length is told, never the token.
if [ "${TINVAR_PROBE_TRUST_LOOPBACK-}" != 0 ]; then
    refuse "TINVAR_PROBE_TRUST_LOOPBACK is '${TINVAR_PROBE_TRUST_LOOPBACK-}': it must be 0 here. Loopback is shared with the rest of the pod, so it is not trusted without the probe token."
fi
probe_token=${TINVAR_PROBE_TOKEN:-}
if ((${#probe_token} < 32)); then
    refuse "The probe token is ${#probe_token} characters: set TINVAR_PROBE_TOKEN, 32 characters or more, which the probes send. Loopback is shared with the rest of the pod here, so it is not trusted without one (TINVAR_PROBE_TRUST_LOOPBACK=0)."
fi
[ -w /tmp ] || refuse "/tmp is not writable: mount a tmpfs there (an emptyDir in a pod)."

# The stop budget (ADR 0078): how long the queue worker has, from SIGTERM,
# before it is killed. Within it a job pauses at its checkpoint or is handed
# back to its queue. serve and the worker are told the same, and the
# platform must give this container that and 30 s more. 10 s is the least:
# the worker's 5 s grace after stopping a job, its 3 s margin before the
# kill, and 2 s for the job to see it is stopping.
stop_budget=${TINVAR_STOP_BUDGET:-70}
if ! [[ $stop_budget =~ ^[0-9]{1,4}$ ]] || ((10#$stop_budget < 10 || 10#$stop_budget > 3600)); then
    refuse "TINVAR_STOP_BUDGET is '$stop_budget': whole seconds from 10 to 3600, the time the queue worker has to stop."
fi
stop_budget=$((10#$stop_budget))
export TINVAR_STOP_BUDGET=$stop_budget
# TINVAR_STOP_GRACE is what the platform gives this container to stop --
# compose's stop_grace_period; a pod's terminationGracePeriodSeconds less
# its preStop and the renderers' drain after -- told here because nothing
# else tells a container. A budget it cannot hold would be cut off by the
# platform's SIGKILL, with the job in hand still held.
if [ -n "${TINVAR_STOP_GRACE:-}" ]; then
    [[ $TINVAR_STOP_GRACE =~ ^[0-9]{1,5}$ ]] || refuse "TINVAR_STOP_GRACE is '$TINVAR_STOP_GRACE': whole seconds, the platform's grace period."
    needs=$((stop_budget + 30))
    if ((10#$TINVAR_STOP_GRACE < needs)); then
        refuse "A stop budget of ${stop_budget} s needs ${needs} s to stop PHP's container (the worker, then FrankenPHP), and the platform gives ${TINVAR_STOP_GRACE} s (TINVAR_STOP_GRACE): lower TINVAR_STOP_BUDGET to $((10#$TINVAR_STOP_GRACE - 30)) or less, or raise the grace period."
    fi
fi

workers=${TINVAR_CONTAINER_WORKERS:-$(nproc)}
say "Starting PHP with $workers workers as $app_user on port $port, rendering through $pool as $renderer_user."

cd "${TINVAR_CONTAINER_CWD:-/}"
# serve waits up to 30 s for the pool, and holds it to the renderers' user
# before FrankenPHP starts.
# shellcheck disable=SC2086 # the command and its arguments, split as written
exec ${TINVAR_CONTAINER_SERVE:?names the command that serves} --host=0.0.0.0 --port="$port" --workers="$workers"
