#!/usr/bin/env bash
#
# What `tinvar deps:check` needs beyond .github/ci/setup to check a new
# release before it proposes one (ADR 0079): gpgv, which holds Node's
# SHASUMS256.txt to the Node release team's keys, and GitHub's CLI, whose
# `gh attestation verify` holds a FrankenPHP binary -- and the next gh --
# to the build provenance GitHub signed for it.
#
# gpgv comes through apt, which checks the archive's signature. gh is one
# exact version held to the sha256 below before it is unpacked; deps:check
# moves it as it moves everything else, verifying the new release's
# attestation with the gh this script installed.
#
# Run as root inside the php:8.5-cli image, after .github/ci/setup.

set -euo pipefail

GH_VERSION=2.103.3
case "$(uname -m)" in
    x86_64)
        GH_ARCH=amd64
        GH_SHA256=4c806978ffce1cec70853302a56d70ac6da4f19bae7adca4e1a8ab00633dd91d
        ;;
    aarch64)
        GH_ARCH=arm64
        GH_SHA256=ee32df2323c8847f5fac6cb6b4b69ca75828e9329a8f22f677021f7b3306ce63
        ;;
    *)
        echo "No gh build is pinned for $(uname -m)." >&2
        exit 1
        ;;
esac

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq --no-install-recommends gpgv >/dev/null

gh="gh_${GH_VERSION}_linux_${GH_ARCH}"
curl --proto '=https' --tlsv1.2 -fsSL --retry 3 -o "$work/gh.tar.gz" \
    "https://github.com/cli/cli/releases/download/v${GH_VERSION}/${gh}.tar.gz"
echo "$GH_SHA256  $work/gh.tar.gz" | sha256sum --check --strict --quiet -
tar -xzf "$work/gh.tar.gz" -C "$work" --no-same-owner "${gh}/bin/gh"
install -m 0755 "$work/${gh}/bin/gh" /usr/local/bin/gh

gpgv --version | head -n 1
gh --version | head -n 1
