<?php

declare(strict_types=1);

namespace App\Http\Queries\Orders;

use App\Database\Models\Accounts\Customer;
use App\Database\Models\Orders\Order;
use App\Http\Data\Orders\OrderData;
use Tinvar\Attributes\Authorize;
use Tinvar\Attributes\Query;

/**
 * orders.showOrder: one order, by its id. What the show page loads, and what
 * a server component may await through its generated `@queries` function.
 *
 * $order is resolved and scoped -- a missing or foreign id is a 404 -- and
 * its policy decides through view(), before this body runs. It names the
 * Customer rows it is read with, so that model's policy is asked too,
 * through viewAny().
 */
#[Query, Authorize('view', 'order'), Authorize('viewAny', Customer::class)]
final class ShowOrder
{
    public function __invoke(Order $order): OrderData
    {
        return OrderData::of($order);
    }
}
